# TradeCore ERP & POS - Production Apache .htaccess Configuration for cPanel
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Deny access to secrets, dotfiles and log files (must come before the
  # static-file rule below, otherwise .env and *.log are served publicly)
  RewriteRule ^\.env(\.\w+)*$ - [F,L]
  RewriteRule ^.*\.env(\.\w+)*$ - [F,L]
  RewriteRule ^.*\.log$ - [F,L]

  # Serve static files directly if they exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route API requests directly to api/api.php if needed
  RewriteRule ^api/php_sync\.php$ api/api.php [L]
  RewriteRule ^api/api\.php$ api/api.php [L]
  RewriteRule ^api/ai-assist$ api/api.php [L]
  RewriteRule ^api/copilot-analysis$ api/api.php [L]
  RewriteRule ^api/forgot-password$ api/api.php [L]
  RewriteRule ^api/reset-password$ api/api.php [L]
  RewriteRule ^api/register$ api/api.php [L]

  # AI endpoints requested at the document root
  RewriteRule ^ai-assist$ api.php [L]
  RewriteRule ^copilot-analysis$ api.php [L]
  RewriteRule ^register$ api/api.php [L]

  # SEO sitemaps (served dynamically by sitemap.php)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^sitemap-products\.xml$ sitemap.php [L]
  RewriteRule ^sitemap-companies\.xml$ sitemap.php [L]

  # SPA Fallback: Route all other web routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security & CORS Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
